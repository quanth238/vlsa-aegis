      [0.5, -0.5, 0.5, -0.5, 0.5, -0.5, 0.5],
      [0.07142857142857142, 0.14285714285714285, 0.21428571428571427, 0.2857142857142857, 0.35714285714285715, 0.42857142857142855, 0.5]
    ],
    "coupled_eta_ladder_s": [2e-06, 5e-07, 1.25e-07, 3.125e-08, 7.8125e-09, 1.953125e-09, 4.8828125e-10],
    "coupled_absolute_tolerance_m2_per_s": 2e-07,
    "coupled_relative_tolerance": 0.0002,
    "coupled_near_zero_m2_per_s": 1e-10,
    "same_trilinear_cell_required": true,
