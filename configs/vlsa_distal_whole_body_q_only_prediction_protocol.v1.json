{
  "schema_version": "vlsa_distal_whole_body_q_only_prediction_protocol.v1",
  "protocol_id": "vlsa-distal-whole-body-q-only-prediction-protocol-v1",
  "claim_scope": "Frozen Q-only per-constraint future-risk prediction protocol. It trains on train roots only and performs one held-out validation/test evaluation even when the external 4/2/2 coverage gate fails; any under-covered result is diagnostic. It does not itself execute correction, QP, denoising, deployment, certification, or establish a CBF.",
  "dataset": {
    "fit_splits": ["train"],
    "evaluation_splits": ["train", "validation", "test"],
    "test_access": "one_time_after_fixed_final_epoch_model",
    "initially_unsafe_rule": "retained_in_source_audit_excluded_from_prevention_fit_and_metrics",
    "known_outcome_rule": "known_only_UNKNOWN_timeouts_censored",
    "candidate_groups_preserved": true,
    "strict_root_episode_splits": true,
    "train_even_if_coverage_fails_as_diagnostic": true
  },
  "features": {
    "translation_scale_m_per_action_unit": 0.05,
    "causal_current_state_and_candidate_only": true,
    "future_executed_state_excluded": true
  },
  "arms": {
    "relative_endpoint_9D": {
      "input_dimension": 9,
      "output_dimension": 3,
      "target_rows": [2, 3, 4]
    },
    "direct_L5_OSC_33D": {
      "input_dimension": 33,
      "output_dimension": 3,
      "target_rows": [2, 3, 4]
    },
    "shared_constraint_135D": {
      "input_dimension": 135,
      "output_dimension": 1,
      "claimed_rows": [1, 2, 3, 4, 5, 6],
      "group_rows": {"palm": [1], "L5": [2, 3, 4], "L6": [5, 6]}
    }
  },
  "model": {
    "hidden_widths": [32, 32],
    "activation": "silu",
    "seed": 20260814,
    "cpu_threads": 8,
    "epochs": 2000,
    "learning_rate": 0.001,
    "weight_decay": 0.0001,
    "gradient_clip_norm": 10.0,
    "huber_beta_normalized": 0.25,
    "boundary_scale": 0.05,
    "boundary_weight_multiplier": 4.0,
    "minimum_target_scale": 0.01,
    "normalization": "training_state_constraint_balanced_only",
    "checkpoint": "fixed_final_epoch_no_validation_or_test_selection"
  },
  "metrics": {
    "near_boundary_abs_risk": 0.05,
    "report_train_validation_test_RMSE": true,
    "report_false_safes_safe_recall_ordering_and_safe_support": true
  },
  "prediction_gate": {
    "heldout_splits": ["validation", "test"],
    "maximum_selected_false_safe_count": 0,
    "minimum_recoverable_state_safe_support_fraction": 1.0,
    "maximum_near_boundary_RMSE": 0.1,
    "minimum_rank_spearman": 0.5,
    "fresh_exact_rollout_rule": "independent_producer_replay_equality_for_every_selected_candidate",
    "correction_requires_external_coverage_and_prediction_pass": true
  },
  "timeout_rule": "UNKNOWN_censored_from_fit_and_metrics",
  "forbidden": [
    "validation_or_test_normalization",
    "validation_or_test_checkpoint_selection",
    "initially_unsafe_recovery_state_as_prevention_fit_data",
    "timeout_as_safe_or_unsafe",
    "V_loss_or_target",
    "asymmetric_loss_calibration_or_monotonic_regularization",
    "candidate_correction_before_both_gates_pass",
    "QP_or_gradient_correction",
    "denoising_or_closed_loop_before_both_gates_pass",
    "deployment_generalization_certification_or_CBF_claim"
  ]
}
