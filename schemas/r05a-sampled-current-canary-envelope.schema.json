        "last_monotonic_timestamp_ns": {
          "type": "integer",
          "minimum": 1
        },
        "timestamps_strictly_increasing": {
          "const": true
        },
        "maximum_adjacent_gap_ns": {
          "type": "integer",
          "minimum": 1,
          "maximum": 500000000
        },
        "host_cgroup_sampled_current_high_water_bytes": {
          "type": "integer",
          "minimum": 1
        },
        "host_cgroup_sampled_current_is_lower_bound_not_peak": {
          "const": true
        },
        "memory_max_before_bytes": {
          "type": "integer",
          "minimum": 1
        },
        "memory_max_after_bytes": {
          "type": "integer",
          "minimum": 1
        },
        "memory_max_unchanged": {
          "const": true
        },
        "memory_events_before": {
          "$ref": "#/$defs/memoryEvents"
        },
        "memory_events_after": {
          "$ref": "#/$defs/memoryEvents"
        },
        "memory_events_deltas": {
          "$ref": "#/$defs/requiredZeroMemoryEventDeltas"
        },
        "required_event_deltas_zero": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "max",
            "oom",
            "oom_kill"
          ],
          "properties": {
            "max": {
              "const": true
            },
            "oom": {
              "const": true
            },
            "oom_kill": {
              "const": true
            }
          }
        },
        "memory_events_local_recorded_as_diagnostic_only": {
          "const": true
        },
        "native_memory_peak_state": {
          "enum": [
            "missing",
            "readable_positive_integer"
          ]
        },
        "native_memory_peak_bytes": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "integer",
              "minimum": 1
            }
          ]
        },
        "lifecycle_markers": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "monitor_ready_ns",
            "policy_server_launch_ns",
            "policy_server_cleanup_complete_ns",
            "gpu_monitor_cleanup_complete_ns",
            "workload_cleanup_complete_ns",
            "monitor_stop_observed_ns"
          ],
          "properties": {
            "monitor_ready_ns": {
              "type": "integer",
              "minimum": 1
            },
            "policy_server_launch_ns": {
              "type": "integer",
              "minimum": 1
            },
            "policy_server_cleanup_complete_ns": {
              "type": "integer",
              "minimum": 1
            },
            "gpu_monitor_cleanup_complete_ns": {
              "type": "integer",
              "minimum": 1
            },
            "workload_cleanup_complete_ns": {
              "type": "integer",
              "minimum": 1
            },
            "monitor_stop_observed_ns": {
              "type": "integer",
              "minimum": 1
            }
          }
        },
        "first_sample_no_later_than_policy_launch": {
          "const": true
        },
        "last_sample_no_earlier_than_workload_cleanup": {
          "const": true
        },
        "monitor_ready_before_setup_python": {
          "const": true
        },
        "sealed_after_workload_cleanup": {
          "const": true
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "native_memory_peak_state": {
                "const": "missing"
              }
            },
            "required": [
              "native_memory_peak_state"
            ]
          },
          "then": {
            "properties": {
              "native_memory_peak_bytes": {
                "type": "null"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "native_memory_peak_state": {
                "const": "readable_positive_integer"
              }
            },
            "required": [
              "native_memory_peak_state"
            ]
          },
          "then": {
            "properties": {
              "native_memory_peak_bytes": {
                "type": "integer",
                "minimum": 1
              }
            }
          }
        }
      ]
    },
    "requiredZeroMemoryEventDeltas": {
      "type": "object",
      "required": [
        "max",
        "oom",
        "oom_kill"
      ],
      "properties": {
        "max": {
          "const": 0
        },
        "oom": {
          "const": 0
        },
        "oom_kill": {
          "const": 0
        }
      },
      "additionalProperties": {
        "type": "integer",
        "minimum": 0
      }
    },
    "gpuTelemetry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "allocation_gpu_uuid",
        "raw_samples_path",
        "raw_samples_sha256",
        "sample_count",
        "process_peak_allocated_bytes",
        "process_peak_reserved_bytes",
        "sampled_compute_high_water_mib",
        "sampled_device_high_water_mib",
        "sampled_values_are_periodic_not_continuous_peaks",
        "out_of_memory_observed"
      ],
      "properties": {
        "allocation_gpu_uuid": {
          "type": "string",
          "pattern": "^GPU-[A-Za-z0-9-]+$"
        },
        "raw_samples_path": {
          "type": "string",
          "pattern": "(^|/)gpu-memory-samples\\.csv$"
        },
        "raw_samples_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "sample_count": {
          "type": "integer",
          "minimum": 1
        },
        "process_peak_allocated_bytes": {
          "type": "integer",
          "minimum": 1
        },
        "process_peak_reserved_bytes": {
          "type": "integer",
          "minimum": 1
        },
        "sampled_compute_high_water_mib": {
          "type": "number",
          "minimum": 0
        },
        "sampled_device_high_water_mib": {
          "type": "number",
          "minimum": 0
        },
        "sampled_values_are_periodic_not_continuous_peaks": {
          "const": true
        },
        "out_of_memory_observed": {
          "const": false
        }
      }
    },
    "absolutePath": {
      "type": "string",
      "pattern": "^/"
    }
  }
}
