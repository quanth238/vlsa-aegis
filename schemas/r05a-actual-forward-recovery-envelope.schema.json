        "original_publisher_job_id": {"const": "28282"},
        "original_publisher_state": {"const": "FAILED"},
        "original_publisher_exit_code": {"const": "1:0"},
        "recovery_publisher_job_id": {"type": "string", "pattern": "^[1-9][0-9]*$", "not": {"const": "28282"}},
        "dependency": {"const": "afterany:28282"},
        "original_receipt_path": {"type": "string", "pattern": "/cpu-afterany-validation\\.json$"},
        "original_receipt_sha256": {"const": "f8e9ef108630cad9a9691dba0827a8be68d3b15e41ee3de2e4e6cfaf03736d27"},
        "recovery_source_contract_path": {"type": "string", "pattern": "/republication-source-contract\\.json$"},
        "recovery_source_contract_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "recovery_submission_path": {"type": "string", "pattern": "/republication-submission\\.json$"},
        "recovery_submission_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "recovery_release_fingerprint_path": {"type": "string", "pattern": "/republication-final-pre-release-fingerprint\\.json$"},
        "recovery_release_fingerprint_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "raw_evidence": {"type": "object"},
    "measured_telemetry": {"type": "object"},
    "validation": {
      "type": "object",
