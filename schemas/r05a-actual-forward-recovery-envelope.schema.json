{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://crfs.local/schemas/r05a-actual-forward-recovery-envelope.schema.json",
  "title": "AF-00A run-C result published by a separately bound recovery CPU",
  "type": "object",
