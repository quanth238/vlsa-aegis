{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/quanth238/vlsa-aegis/schemas/generated-source-state.schema.json",
  "title": "Custom task-0 generated source state",
  "oneOf": [
    {"$ref": "#/$defs/acceptedBundle"},
    {"$ref": "#/$defs/rejectedBundle"}
  ],
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "arrayRecord": {
      "type": "object",
      "additionalProperties": false,
      "required": ["dtype", "shape", "values", "sha256"],
      "properties": {
        "dtype": {"type": "string", "minLength": 1},
        "shape": {"type": "array", "items": {"type": "integer", "minimum": 0}},
        "values": {"type": "array"},
        "sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "float64Vector7": {
      "type": "object",
      "additionalProperties": false,
      "required": ["dtype", "shape", "values", "sha256"],
      "properties": {
        "dtype": {"const": "float64"},
        "shape": {"const": [7]},
        "values": {
          "type": "array", "minItems": 7, "maxItems": 7,
          "items": {"type": "number"}
        },
        "sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "float64Vector6": {
      "type": "object",
      "additionalProperties": false,
      "required": ["dtype", "shape", "values", "sha256"],
      "properties": {
        "dtype": {"const": "float64"},
        "shape": {"const": [6]},
        "values": {
          "type": "array", "minItems": 6, "maxItems": 6,
          "items": {"type": "number"}
        },
        "sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "float64Vector3": {
      "type": "object",
      "additionalProperties": false,
      "required": ["dtype", "shape", "values", "sha256"],
      "properties": {
        "dtype": {"const": "float64"},
        "shape": {"const": [3]},
        "values": {
          "type": "array", "minItems": 3, "maxItems": 3,
          "items": {"type": "number"}
        },
        "sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "float64Matrix3": {
      "type": "object",
      "additionalProperties": false,
      "required": ["dtype", "shape", "values", "sha256"],
      "properties": {
        "dtype": {"const": "float64"},
        "shape": {"const": [3, 3]},
        "values": {
          "type": "array", "minItems": 3, "maxItems": 3,
          "items": {
            "type": "array", "minItems": 3, "maxItems": 3,
            "items": {"type": "number"}
          }
        },
        "sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "float64Vector1": {
      "type": "object",
      "additionalProperties": false,
      "required": ["dtype", "shape", "values", "sha256"],
      "properties": {
        "dtype": {"const": "float64"},
        "shape": {"const": [1]},
        "values": {
          "type": "array", "minItems": 1, "maxItems": 1,
          "items": {"type": "number"}
        },
        "sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "float64Matrix3x7": {
      "type": "object",
      "additionalProperties": false,
      "required": ["dtype", "shape", "values", "sha256"],
      "properties": {
        "dtype": {"const": "float64"},
        "shape": {"const": [3, 7]},
        "values": {
          "type": "array", "minItems": 3, "maxItems": 3,
          "items": {
            "type": "array", "minItems": 7, "maxItems": 7,
            "items": {"type": "number"}
          }
        },
        "sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "float64Matrix6x7": {
      "type": "object",
      "additionalProperties": false,
      "required": ["dtype", "shape", "values", "sha256"],
      "properties": {
        "dtype": {"const": "float64"},
        "shape": {"const": [6, 7]},
        "values": {
          "type": "array", "minItems": 6, "maxItems": 6,
          "items": {
            "type": "array", "minItems": 7, "maxItems": 7,
            "items": {"type": "number"}
          }
        },
        "sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "float64Matrix7": {
      "type": "object",
      "additionalProperties": false,
      "required": ["dtype", "shape", "values", "sha256"],
      "properties": {
        "dtype": {"const": "float64"},
        "shape": {"const": [7, 7]},
        "values": {
          "type": "array", "minItems": 7, "maxItems": 7,
          "items": {
            "type": "array", "minItems": 7, "maxItems": 7,
            "items": {"type": "number"}
          }
        },
        "sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "controllerState": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "robot_count", "robot_name", "controller_class", "controller_name",
        "robosuite_version", "controller_config_identity", "controller_config_sha256",
        "controller_static_sha256", "control_dim", "control_freq", "use_delta", "use_ori",
        "uncoupling", "position_limits", "orientation_limits", "input_min", "input_max",
        "output_min", "output_max", "kp", "kd", "action_scale", "action_input_transform",
        "action_output_transform",
        "impedance_mode", "position_interpolator", "orientation_interpolator",
        "gripper_class", "gripper_dof", "ee_position", "ee_orientation_matrix",
        "ee_linear_velocity", "ee_angular_velocity", "joint_position", "joint_velocity",
        "jacobian_position", "jacobian_orientation", "jacobian_full", "mass_matrix",
        "initial_joint", "goal_position", "goal_orientation_matrix", "new_update",
        "gripper_current_action", "fingerprint_sha256"
      ],
      "properties": {
        "robot_count": {"type": "integer", "const": 1},
        "robot_name": {"const": "Panda"},
        "robosuite_version": {"const": "1.4.1"},
        "controller_config_identity": {
          "const": "robosuite-1.4.1/robosuite/controllers/config/osc_pose.json"
        },
        "controller_config_sha256": {
          "const": "07f3a8b41d3eecc8a36700a85bd8207ee3fbc36eb73f6a2248340c96770d1e45"
        },
        "controller_static_sha256": {"$ref": "#/$defs/sha256"},
        "controller_class": {"const": "OperationalSpaceController"},
        "controller_name": {"const": "OSC_POSE"},
        "impedance_mode": {"const": "fixed"},
        "control_dim": {"type": "integer", "const": 6},
        "control_freq": {"type": "integer", "const": 20},
        "use_delta": {"const": true},
        "use_ori": {"const": true},
        "uncoupling": {"const": true},
        "position_limits": {"type": "null"},
        "orientation_limits": {"type": "null"},
        "position_interpolator": {"type": "null"},
        "orientation_interpolator": {"type": "null"},
        "input_min": {"$ref": "#/$defs/float64Vector6"},
        "input_max": {"$ref": "#/$defs/float64Vector6"},
        "output_min": {"$ref": "#/$defs/float64Vector6"},
        "output_max": {"$ref": "#/$defs/float64Vector6"},
        "kp": {"$ref": "#/$defs/float64Vector6"},
        "kd": {"$ref": "#/$defs/float64Vector6"},
        "action_scale": {"type": "null"},
        "action_input_transform": {"type": "null"},
        "action_output_transform": {"type": "null"},
        "gripper_class": {"const": "PandaGripper"},
        "gripper_dof": {"type": "integer", "const": 1},
        "ee_position": {"$ref": "#/$defs/float64Vector3"},
        "ee_orientation_matrix": {"$ref": "#/$defs/float64Matrix3"},
        "ee_linear_velocity": {"$ref": "#/$defs/float64Vector3"},
        "ee_angular_velocity": {"$ref": "#/$defs/float64Vector3"},
        "joint_position": {"$ref": "#/$defs/float64Vector7"},
        "joint_velocity": {"$ref": "#/$defs/float64Vector7"},
        "jacobian_position": {"$ref": "#/$defs/float64Matrix3x7"},
        "jacobian_orientation": {"$ref": "#/$defs/float64Matrix3x7"},
        "jacobian_full": {"$ref": "#/$defs/float64Matrix6x7"},
        "mass_matrix": {"$ref": "#/$defs/float64Matrix7"},
        "initial_joint": {"$ref": "#/$defs/float64Vector7"},
        "goal_position": {"$ref": "#/$defs/float64Vector3"},
        "goal_orientation_matrix": {"$ref": "#/$defs/float64Matrix3"},
        "new_update": {"const": false},
        "gripper_current_action": {"$ref": "#/$defs/float64Vector1"},
        "fingerprint_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "controllerCanonicalization": {
      "type": "object",
      "additionalProperties": false,
      "required": ["method", "pre_settle", "final"],
      "properties": {
        "method": {
          "const": "single_panda_fixed_osc_pose_static_bound_lazy_scale_reset_update_initial_joints_double_reset_goal_zero_gripper_v1"
        },
        "pre_settle": {"$ref": "#/$defs/controllerState"},
        "final": {"$ref": "#/$defs/controllerState"}
      }
    },
    "geometryJointPose": {
      "type": "object",
      "additionalProperties": false,
      "required": ["object_name", "joint_name", "qpos"],
      "properties": {
        "object_name": {"type": "string", "minLength": 1},
        "joint_name": {"type": "string", "minLength": 1},
        "qpos": {"$ref": "#/$defs/float64Vector7"}
      }
    },
    "geometryGeom": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name", "body_name", "type_id", "contype", "conaffinity",
        "size", "world_position", "world_rotation"
      ],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "body_name": {"type": "string", "minLength": 1},
        "type_id": {"type": "integer", "minimum": 0},
        "contype": {"type": "integer", "minimum": 0},
        "conaffinity": {"type": "integer", "minimum": 0},
        "size": {"$ref": "#/$defs/float64Vector3"},
        "world_position": {"$ref": "#/$defs/float64Vector3"},
        "world_rotation": {"$ref": "#/$defs/float64Matrix3"}
      }
    },
    "sourceGeometry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["active_obstacle_name", "joint_poses", "active_obstacle_geoms"],
      "properties": {
        "active_obstacle_name": {
          "enum": [
            "moka_pot_obstacle_1", "milk_obstacle_1", "wine_bottle_obstacle_1",
            "red_coffee_mug_obstacle_1", "yellow_book_obstacle_1"
          ]
        },
        "joint_poses": {
          "type": "array", "minItems": 7, "maxItems": 7,
          "prefixItems": [
            {"allOf": [
              {"$ref": "#/$defs/geometryJointPose"},
              {"properties": {"object_name": {"const": "moka_pot_obstacle_1"}}}
            ]},
            {"allOf": [
              {"$ref": "#/$defs/geometryJointPose"},
              {"properties": {"object_name": {"const": "white_storage_box_obstacle_1"}}}
            ]},
            {"allOf": [
              {"$ref": "#/$defs/geometryJointPose"},
              {"properties": {"object_name": {"const": "milk_obstacle_1"}}}
            ]},
            {"allOf": [
              {"$ref": "#/$defs/geometryJointPose"},
              {"properties": {"object_name": {"const": "wine_bottle_obstacle_1"}}}
            ]},
            {"allOf": [
              {"$ref": "#/$defs/geometryJointPose"},
              {"properties": {"object_name": {"const": "red_coffee_mug_obstacle_1"}}}
            ]},
            {"allOf": [
              {"$ref": "#/$defs/geometryJointPose"},
              {"properties": {"object_name": {"const": "yellow_book_obstacle_1"}}}
            ]},
            {"allOf": [
              {"$ref": "#/$defs/geometryJointPose"},
              {"properties": {"object_name": {"const": "box_base_1"}}}
            ]}
          ],
          "items": false
        },
        "active_obstacle_geoms": {
          "type": "array", "minItems": 1,
          "items": {"$ref": "#/$defs/geometryGeom"}
        }
      }
    },
    "settleState": {
      "type": "object",
      "additionalProperties": false,
      "required": ["dtype", "shape", "values", "sha256", "settle_step"],
      "properties": {
        "dtype": {"type": "string", "minLength": 1},
        "shape": {"type": "array", "items": {"type": "integer", "minimum": 0}},
        "values": {"type": "array"},
        "sha256": {"$ref": "#/$defs/sha256"},
        "settle_step": {"type": "integer", "minimum": 1, "maximum": 20}
      }
    },
    "integrationStateSpec": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "value", "size", "dtype"],
      "properties": {
        "name": {"const": "mjSTATE_INTEGRATION"},
        "value": {"const": 8191},
        "size": {"type": "integer", "minimum": 1},
        "dtype": {"const": "float64"}
      }
    },
    "integrationStates": {
      "type": "object",
      "additionalProperties": false,
      "required": ["spec", "pre_settle", "settle_history", "settle_sequence_sha256", "final"],
      "properties": {
        "spec": {"$ref": "#/$defs/integrationStateSpec"},
        "pre_settle": {"$ref": "#/$defs/arrayRecord"},
        "settle_history": {
          "type": "array", "minItems": 20, "maxItems": 20,
          "items": {"$ref": "#/$defs/settleState"}
        },
        "settle_sequence_sha256": {"$ref": "#/$defs/sha256"},
        "final": {"$ref": "#/$defs/arrayRecord"}
      }
    },
    "numpyLegacyState": {
      "type": "object",
      "additionalProperties": false,
      "required": ["algorithm", "keys", "position", "has_gauss", "cached_gaussian"],
      "properties": {
        "algorithm": {"const": "MT19937"},
        "keys": {"$ref": "#/$defs/arrayRecord"},
        "position": {"type": "integer", "minimum": 0},
        "has_gauss": {"enum": [0, 1]},
        "cached_gaussian": {"type": "number"}
      }
    },
    "rng": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "reset_seed", "reset_api", "numpy_legacy_state_before_reset", "numpy_legacy_state_after_reset",
        "placement_seed", "placement_algorithm", "placement_state_before", "placement_state_after",
        "active_x_uniform_draw_m", "active_x_uniform_range_m"
      ],
      "properties": {
        "reset_seed": {"type": "integer", "minimum": 0},
        "reset_api": {"const": "env.seed_plus_numpy_legacy_seed_before_exactly_one_reset"},
        "numpy_legacy_state_before_reset": {"$ref": "#/$defs/numpyLegacyState"},
        "numpy_legacy_state_after_reset": {"$ref": "#/$defs/numpyLegacyState"},
        "placement_seed": {"type": "integer", "minimum": 0},
        "placement_algorithm": {"const": "numpy.random.PCG64"},
        "placement_state_before": {"type": "object"},
        "placement_state_after": {"type": "object"},
        "active_x_uniform_draw_m": {"type": "number", "minimum": -0.08, "maximum": -0.07},
        "active_x_uniform_range_m": {"const": [-0.08, -0.07]}
      }
    },
    "editRecord": {
      "type": "object",
      "additionalProperties": false,
      "required": ["operation", "object_name", "joint_name", "joint_type", "addressing", "before", "after"],
      "properties": {
        "operation": {"enum": ["park_declared_obstacle", "activate_assigned_obstacle", "move_box_base_to_active_xy"]},
        "object_name": {"type": "string"},
        "joint_name": {"type": "string"},
        "joint_type": {"const": "free"},
        "addressing": {"const": "named_joint_no_hard_coded_qpos_offset"},
        "before": {"$ref": "#/$defs/arrayRecord"},
        "after": {"$ref": "#/$defs/arrayRecord"}
      }
    },
    "edits": {
      "type": "object",
      "additionalProperties": false,
      "required": ["contract", "active_pose_xyz_m", "box_base_pose_xyz_m", "log"],
      "properties": {
        "contract": {"const": "named_free_joints_only_no_hard_coded_qpos_offsets"},
        "active_pose_xyz_m": {"type": "array", "minItems": 3, "maxItems": 3, "items": {"type": "number"}},
        "box_base_pose_xyz_m": {"type": "array", "minItems": 3, "maxItems": 3, "items": {"type": "number"}},
        "log": {"type": "array", "minItems": 8, "maxItems": 8, "items": {"$ref": "#/$defs/editRecord"}}
      }
    },
    "settle": {
      "type": "object",
      "additionalProperties": false,
      "required": ["step_count", "action_semantics", "actions"],
      "properties": {
        "step_count": {"const": 20},
        "action_semantics": {"const": "baseline_LIBERO_dummy_control_no_policy_action"},
        "actions": {"$ref": "#/$defs/arrayRecord"}
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "git_commit", "git_dirty", "baseline_commit", "slurm_job_id", "slurm_array_job_id",
        "slurm_array_task_id", "partition", "host", "python", "physics_device", "render_device",
        "allocation_visible_gpu",
        "mujoco_gl", "pyopengl_platform", "purpose", "policy_server_started", "policy_calls",
        "model_loaded", "training", "created_at_utc"
      ],
      "properties": {
        "git_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "git_dirty": {"const": false},
        "baseline_commit": {"const": "57b1aef306f212aea3574b0a3b64aa1a3d8f5e4b"},
        "slurm_job_id": {"type": "string", "minLength": 1},
        "slurm_array_job_id": {"type": "string", "minLength": 1},
        "slurm_array_task_id": {"type": "string", "minLength": 1},
        "partition": {"type": ["string", "null"]},
        "host": {"type": "string", "minLength": 1},
        "python": {"type": "string", "minLength": 1},
        "physics_device": {"const": "cpu"},
        "render_device": {"const": "cpu_osmesa"},
        "allocation_visible_gpu": {"type": "string", "minLength": 1},
        "mujoco_gl": {"const": "osmesa"},
        "pyopengl_platform": {"const": "osmesa"},
        "purpose": {"const": "source_state_generation_and_rendering_only"},
        "policy_server_started": {"const": false},
        "policy_calls": {"const": 0},
        "model_loaded": {"const": false},
        "training": {"const": false},
        "created_at_utc": {"type": "string", "minLength": 1}
      }
    },
    "sourceState": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_state_id", "source_state_sha256", "source_branch_sha256", "generation_request_id", "group_index",
        "task_suite", "safety_level", "task_index", "task_name", "active_obstacle_name"
      ],
      "properties": {
        "source_state_id": {"type": "string", "pattern": "^gsrc-[0-9a-f]{16}$"},
        "source_state_sha256": {"$ref": "#/$defs/sha256"},
        "source_branch_sha256": {"$ref": "#/$defs/sha256"},
        "generation_request_id": {"type": "string", "pattern": "^greq-task0-single-obstacle-v1-[0-9]{4}$"},
        "group_index": {"type": "integer", "minimum": 0, "maximum": 9},
        "task_suite": {"const": "safelibero_spatial"},
        "safety_level": {"const": "generated"},
        "task_index": {"const": 0},
        "task_name": {"const": "pick_up_the_black_bowl_between_the_plate_and_the_ramekin_and_place_it_on_the_plate"},
        "active_obstacle_name": {
          "enum": [
            "moka_pot_obstacle_1", "milk_obstacle_1", "wine_bottle_obstacle_1",
            "red_coffee_mug_obstacle_1", "yellow_book_obstacle_1"
          ]
        }
      }
    },
    "selection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "outcome_blind", "one_reset_attempt_per_source_group", "resampling", "policy_called",
        "policy_actions_executed", "safety_or_task_outcomes_computed", "prohibited_rejection_signals"
      ],
      "properties": {
        "outcome_blind": {"const": true},
        "one_reset_attempt_per_source_group": {"const": true},
        "resampling": {"const": false},
        "policy_called": {"const": false},
        "policy_actions_executed": {"const": 0},
        "safety_or_task_outcomes_computed": {"const": false},
        "prohibited_rejection_signals": {
          "const": ["collision", "clearance", "probe", "planner", "progress", "policy_action"]
        }
      }
    },
    "rejection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["rejected", "outcome_blind", "stage", "code", "message"],
      "properties": {
        "rejected": {"type": "boolean"},
        "outcome_blind": {"const": true},
        "stage": {"type": ["string", "null"]},
        "code": {"type": ["string", "null"]},
        "message": {"type": ["string", "null"]}
      }
    },
    "asset": {
      "type": "object",
      "additionalProperties": false,
      "required": ["token", "element_tag", "element_name", "original_path", "locator", "size_bytes", "sha256"],
      "properties": {
        "token": {"type": "string", "pattern": "^crfs-asset://[0-9]{4}$"},
        "element_tag": {"type": "string"},
        "element_name": {"type": ["string", "null"]},
        "original_path": {"type": "string"},
        "locator": {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "path"],
          "properties": {
            "kind": {"enum": ["repo_relative", "libero_package_relative", "robosuite_package_relative"]},
            "path": {"type": "string", "minLength": 1}
          }
        },
        "size_bytes": {"type": "integer", "minimum": 1},
        "sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "model": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "format", "xml", "sha256", "assets", "assets_sha256"
      ],
      "properties": {
        "format": {"const": "portable_finalized_mujoco_xml_with_hashed_asset_tokens"},
        "xml": {"type": "string", "minLength": 1},
        "sha256": {"$ref": "#/$defs/sha256"},
        "assets": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/asset"}},
        "assets_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "sourceBranchPayload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "bddl_sha256", "portable_model_xml_sha256", "model_asset_manifest_sha256",
        "final_flattened_state_sha256", "observation_sha256", "geometry_sha256",
        "integration_state_spec_name", "integration_state_spec_value",
        "integration_state_size", "integration_state_dtype",
        "pre_settle_integration_state_sha256", "settle_integration_state_sequence_sha256",
        "final_integration_state_sha256", "controller_canonicalization_method",
        "pre_settle_controller_state_sha256", "final_controller_state_sha256"
      ],
      "properties": {
        "bddl_sha256": {"$ref": "#/$defs/sha256"},
        "portable_model_xml_sha256": {"$ref": "#/$defs/sha256"},
        "model_asset_manifest_sha256": {"$ref": "#/$defs/sha256"},
        "final_flattened_state_sha256": {"$ref": "#/$defs/sha256"},
        "observation_sha256": {"$ref": "#/$defs/sha256"},
        "geometry_sha256": {"$ref": "#/$defs/sha256"},
        "integration_state_spec_name": {"const": "mjSTATE_INTEGRATION"},
        "integration_state_spec_value": {"const": 8191},
        "integration_state_size": {"type": "integer", "minimum": 1},
