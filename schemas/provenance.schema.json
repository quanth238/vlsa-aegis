{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CRFS experiment provenance",
  "type": "object",
  "required": [
    "git_commit",
    "git_dirty",
    "baseline_commit",
    "python_version",
    "host",
    "timestamp",
    "task_suite",
    "safety_level",
    "task_index",
    "episode_index",
    "environment_seed",
    "policy_seed",
    "checkpoint_id",
    "checkpoint_sha256",
    "sampler_steps",
    "intervention_step",
    "action_frame",
    "correction_space",
    "slurm_job_id",
    "partition",
    "gpu_type"
  ],
  "properties": {
    "git_commit": { "type": "string" },
    "git_dirty": { "type": "boolean" },
    "baseline_commit": { "const": "57b1aef306f212aea3574b0a3b64aa1a3d8f5e4b" },
    "python_version": { "type": "string" },
    "host": { "type": "string" },
    "timestamp": { "type": "string" },
    "task_suite": { "type": "string" },
    "safety_level": { "enum": ["I", "II"] },
    "task_index": { "type": "integer" },
    "episode_index": { "type": "integer" },
    "environment_seed": { "type": "integer" },
    "policy_seed": { "type": "integer" },
    "checkpoint_id": { "type": "string" },
    "checkpoint_sha256": { "type": "string" },
    "sampler_steps": { "type": "integer", "minimum": 1 },
    "intervention_step": { "type": "integer", "minimum": 0 },
    "action_frame": { "type": "string" },
    "correction_space": { "enum": ["physical", "model"] },
    "slurm_job_id": { "type": ["string", "null"] },
    "partition": { "type": ["string", "null"] },
    "gpu_type": { "type": ["string", "null"] }
  }
}
